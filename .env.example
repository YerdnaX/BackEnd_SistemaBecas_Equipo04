# Copia este archivo como .env y completa los valores reales.
# NUNCA escribas la contrasena real de la base de datos en este archivo de ejemplo.

PORT=3000
NODE_ENV=development

DB_SERVER=tiusr15pl.cuc-carrera-ti.ac.cr
DB_PORT=1433
DB_DATABASE=tiusr15pl_SGBE_CUC_Equipo04
DB_USER=Equipo04
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_DURACION=15m
JWT_REFRESH_DURACION=7d

URL_FRONTEND=http://localhost:5173

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SGBE CUC <no-responder@cuc.ac.cr>

# Proveedor recomendado para Render: Gmail API (HTTPS)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_OAUTH_USER=me

TAMANO_MAXIMO_ARCHIVO_MB=8
OTP_DURACION_MINUTOS=10
OTP_INTENTOS_MAXIMOS=5
TOKEN_ACTIVACION_HORAS=24
TOKEN_RECUPERACION_HORAS=24
AUTENTICACION_RATE_LIMIT_HABILITADO=false
AUTENTICACION_RATE_LIMIT_VENTANA_MS=900000
AUTENTICACION_RATE_LIMIT_MAXIMO=10
AUTENTICACION_BLOQUEO_INTENTOS_HABILITADO=false

# Asistente virtual (boton de chat), via un proveedor de IA compatible con el
# protocolo "Chat Completions" (formato OpenAI). Por defecto usa GitHub Models
# (gratis con cualquier cuenta de GitHub). Tambien sirve para Google Gemini,
# Groq, OpenAI, etc. cambiando estas variables, sin tocar codigo.
# Ver documentacion/GUIA_ASISTENTE_IA.md para el paso a paso completo.
ASISTENTE_IA_API_KEY=
ASISTENTE_IA_URL=https://models.github.ai/inference/chat/completions
ASISTENTE_IA_MODELO=openai/gpt-4o-mini
ASISTENTE_IA_TIMEOUT_MS=20000

# Verificacion de cedula durante el registro (autocompletar nombre y
# apellidos). Servicio de terceros no oficial (mirror del padron de
# Hacienda/TSE); requiere una API key propia. Sin configurar, el registro
# sigue funcionando de forma manual (la cedula igual se valida por formato
# y unicidad en el servidor).
CONSULTA_CEDULA_API_KEY=
CONSULTA_CEDULA_URL=https://www.soportereal.com/herramientas/contribuyentes/v1/contribuyente
CONSULTA_CEDULA_TIMEOUT_MS=8000
